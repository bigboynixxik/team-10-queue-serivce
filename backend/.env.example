
POSTGRES_USER=queue_service
POSTGRES_PASSWORD=queue_service
POSTGRES_DB=queue_service
POSTGRES_PORT=5432

REDIS_PORT=6379

PG_DSN=postgres://queue_service:queue_service@postgres:5432/queue_service?sslmode=disable
REDIS_ADDR=redis:6379
ENV=local
BACKEND_PORT=8080
RIGHT_TTL=15m
OFFER_TTL=2m
SHUTDOWN_TIMEOUT=10s

# AvitoBackend — external system that owns the physical stock and the checkout.
AVITO_BASE_URL=http://avitomock:9090
AVITO_MOCK_PORT=9090
# Shared secret for service-to-service calls in both directions. Empty disables
# the check, which is only sane locally.
INTERNAL_TOKEN=local-internal-secret
# Stock the mock hands out for a product nobody has asked about yet.
DEFAULT_STOCK=3
