# Rendered by the nginx image entrypoint: ${BACKEND_ORIGIN} comes from the
# environment, everything written as $name is an nginx variable and stays as is.

# The queue status endpoint upgrades to a WebSocket on the same URL it serves
# over HTTP, so the connection header has to follow whatever the client sent.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# HttpClient sends withCredentials: true, and a credentialed request rejects
# "*" — the origin has to be echoed back verbatim.
map $http_origin $cors_origin {
  default $http_origin;
  ''      '';
}

# Empty add_header values are skipped, so a request without Origin (curl,
# Postman, the Order Service) gets no CORS headers at all.
map $http_origin $cors_credentials {
  default 'true';
  ''      '';
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(?:css|js|mjs|map|svg|ico|woff2?)$ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # /api/v1/queue/... -> backend:8080/api/v1/queue/...  proxy_pass without a path
  # forwards the URI untouched, so the API version reaches the backend instead of
  # being stripped here.
  # Same-origin for the dockerised frontend, so no preflight happens at all; the
  # CORS headers below only matter for a dev server running on another port.
  location /api/ {
    if ($request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin $cors_origin always;
      add_header Access-Control-Allow-Credentials $cors_credentials always;
      add_header Access-Control-Allow-Methods 'GET, POST, PATCH, DELETE, OPTIONS' always;
      add_header Access-Control-Allow-Headers 'Content-Type, X-User-Id' always;
      add_header Access-Control-Max-Age 86400 always;
      add_header Content-Length 0;
      return 204;
    }

    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Credentials $cors_credentials always;

    proxy_pass ${BACKEND_ORIGIN};
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # A queue WebSocket stays open while the user waits, and the stub pushes
    # only on change — a short read timeout would drop a quiet but live socket.
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_buffering off;
  }
}
