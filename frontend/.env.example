# Only needed for `npm run dev` outside Docker — the dockerised frontend bakes
# /api into the bundle at build time (see docker/Dockerfile.prod).
#
# Point the dev server at nginx rather than straight at :8080: nginx is what adds
# the CORS headers, the backend itself does not.
PUBLIC_API_BASE_URL=http://localhost/api/v1
PUBLIC_CHECKOUT_BASE_URL=http://localhost:9090

# Changing the key issues every browser a fresh guest identity.
PUBLIC_USER_ID_STORAGE_KEY=queue-service:user-id

PUBLIC_APP_STALE_TIME=30000