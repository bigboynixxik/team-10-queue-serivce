{
  "manifest_version": 3,
  "name": "Avito Queue Service",
  "description": "Добавляет переход к сервису очереди на странице объявления Avito.",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": [
        "https://www.avito.ru/*",
        "https://avito.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
